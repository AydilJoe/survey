{
  "appId": "com.aydiljoe.duitful",
  "appName": "Duitful",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "LocalNotifications": {
      "iconColor": "#c8704b"
    }
  },
  "ios": {
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/camera",
      "@capacitor/local-notifications",
