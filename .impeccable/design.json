  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one filled action per card. Ink on light, warm sand on dark.",
      "html": "<button class=\"ds-btn-primary\">Add entry</button>",
      "css": ".ds-btn-primary{background:var(--text);color:var(--card);border:1px solid transparent;border-radius:var(--r-sm);padding:.7rem 1rem;font:600 .95rem var(--font-sans);letter-spacing:-.2px;cursor:pointer;transition:background .15s ease,transform .05s ease}.ds-btn-primary:hover{opacity:.92}.ds-btn-primary:active{transform:scale(.98)}.ds-btn-primary:focus-visible{outline:2px solid var(--brand-ink);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Every secondary action.",
      "html": "<button class=\"ds-btn-ghost\">All entries</button>",
      "css": ".ds-btn-ghost{background:transparent;color:var(--ink2);border:1px solid var(--line);border-radius:var(--r-sm);padding:.45rem .7rem;font:600 .85rem var(--font-sans);cursor:pointer;transition:background .15s ease,transform .05s ease}.ds-btn-ghost:hover{background:var(--card-soft);color:var(--text)}.ds-btn-ghost:active{transform:scale(.98)}.ds-btn-ghost:focus-visible{outline:2px solid var(--brand-ink);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Outlined at rest, fills on hover or focus.",
      "html": "<button class=\"ds-btn-danger\">Erase everything</button>",
      "css": ".ds-btn-danger{background:transparent;color:var(--danger);border:1px solid var(--danger);border-radius:var(--r-sm);padding:.7rem 1rem;font:600 .95rem var(--font-sans);cursor:pointer;transition:background .15s ease}.ds-btn-danger:hover,.ds-btn-danger:focus-visible{background:var(--danger);color:var(--on-danger)}.ds-btn-danger:focus-visible{outline:2px solid var(--danger-hover);outline-offset:2px}"
    },
    {
      "name": "Amount Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Soft-sheet fill, tabular digits.",
      "html": "<input class=\"ds-input\" inputmode=\"decimal\" placeholder=\"0.00\">",
      "css": ".ds-input{width:100%;padding:.75rem .85rem;font:500 1.5rem var(--font-sans);font-variant-numeric:tabular-nums;color:var(--text);background:var(--card-soft);border:1px solid var(--line);border-radius:var(--r-md)}.ds-input::placeholder{color:var(--muted)}.ds-input:focus{outline:2px solid var(--brand-ink);outline-offset:1px;border-color:var(--brand-ink)}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pills; the selected one fills ink navy.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\">This week</button><button class=\"ds-chip ds-chip-on\">This month</button></div>",
      "css": ".ds-chips{display:flex;gap:.4rem}.ds-chip{background:var(--card);color:var(--ink2);border:1px solid var(--line);border-radius:var(--r-pill);padding:.45rem .75rem;font:500 .82rem var(--font-sans);cursor:pointer;transition:background .15s ease}.ds-chip:hover{background:var(--card-soft)}.ds-chip-on,.ds-chip-on:hover{background:var(--primary);color:var(--card);border-color:var(--primary)}.ds-chip:focus-visible{outline:2px solid var(--brand-ink);outline-offset:2px}"
    },
    {
      "name": "Bottom Tab",
      "kind": "nav",
      "refersTo": "tab-active-icon",
      "description": "Active tab: terracotta-tinted icon pill, full-ink label.",
      "html": "<nav class=\"ds-tabs\"><button class=\"ds-tab ds-tab-on\"><span class=\"ds-tab-i\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 11l9-7 9 7v9a2 2 0 01-2 2h-4v-6H9v6H5a2 2 0 01-2-2v-9z\"/></svg></span>Home</button><button class=\"ds-tab\"><span class=\"ds-tab-i\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"6\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M3 10h18\"/></svg></span>Debts</button></nav>",
      "css": ".ds-tabs{display:flex;gap:.25rem;padding:.35rem .25rem;background:color-mix(in srgb,var(--stage) 88%,transparent);border-top:1px solid var(--line)}.ds-tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:.2rem;background:none;border:0;border-radius:var(--r-sm);padding:.3rem .2rem;font:600 .82rem var(--font-sans);color:var(--muted);cursor:pointer}.ds-tab-i{display:grid;place-items:center;width:52px;height:28px;border-radius:var(--r-pill);transition:background .2s ease}.ds-tab:hover .ds-tab-i{background:color-mix(in srgb,var(--brand) 9%,transparent)}.ds-tab-on{color:var(--text)}.ds-tab-on .ds-tab-i,.ds-tab-on:hover .ds-tab-i{background:color-mix(in srgb,var(--brand) 20%,transparent);color:var(--brand-ink)}.ds-tab:focus-visible{outline:2px solid var(--brand-ink);outline-offset:2px}"
    },
    {
      "name": "Balance Card",
      "kind": "card",
