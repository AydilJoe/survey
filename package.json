{
  "name": "duitful",
  "version": "1.53.1",
  "license": "GPL-3.0-only",
  "private": true,
  "description": "Duitful — Capacitor shell for the PWA.",
  "scripts": {
    "postinstall": "node scripts/patch-google-auth.mjs && node scripts/patch-android-plugins-agp9.mjs",
    "fetch:tesseract": "node scripts/fetch-tesseract.mjs",
    "build:guides": "node scripts/build-guides.mjs",
    "build:web": "node scripts/build-web.mjs",
    "assets": "npx @capacitor/assets generate --assetPath resources --iconBackgroundColor \"#e8dfd0\" --iconBackgroundColorDark \"#2a2420\" --splashBackgroundColor \"#e8dfd0\" --splashBackgroundColorDark \"#2a2420\" && node scripts/generate-stat-icon.mjs",
    "native:notification-listener": "node scripts/install-notification-listener.mjs",
    "native:duitful-kit": "node scripts/install-duitful-kit.mjs",
    "patch:android": "node scripts/patch-android-aapt.mjs",
    "patch:android-plugins-agp9": "node scripts/patch-android-plugins-agp9.mjs",
    "patch:android-play-vitals": "node scripts/patch-android-play-vitals.mjs",
    "patch:android-camera": "node scripts/patch-android-camera.mjs",
    "patch:android-biometric": "node scripts/patch-android-biometric.mjs",
    "patch:android-applinks": "node scripts/patch-android-applinks.mjs",
    "patch:android-shortcuts": "node scripts/patch-android-shortcuts.mjs",
    "patch:android-widget": "node scripts/patch-android-widget.mjs",
    "patch:ios": "node scripts/patch-ios.mjs",
    "cap:sync": "npm run build:web && npx cap sync && npm run patch:android && npm run patch:android-camera && npm run patch:android-biometric && npm run patch:android-applinks && npm run patch:android-shortcuts && npm run patch:android-widget && npm run patch:ios && npm run native:notification-listener && npm run native:duitful-kit && npm run patch:android-plugins-agp9 && npm run patch:android-play-vitals",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:add:ios": "npm run build:web && npx cap add ios --packagemanager CocoaPods",
    "cap:add:android": "npm run build:web && npx cap add android",
    "cap:migrate": "npx cap migrate",
    "test:e2e": "node tests/e2e.mjs",
    "check:applinks": "node scripts/check-applinks.mjs",
    "render:site-images": "node scripts/render-site-images.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capawesome/capacitor-app-update": "^8.1.1",
    "@capgo/capacitor-native-biometric": "^8.9.1",
    "@capgo/capacitor-social-login": "^8.7.5",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@pantrist/capacitor-plugin-ml-kit-text-recognition": "^8.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "cordova-plugin-purchase": "^13.19.1",
    "duitful-capacitor-icloud": "file:native/icloud-backup",
    "duitful-capacitor-kit": "file:native/duitful-kit"
  },
  "overrides": {
    "@codetrix-studio/capacitor-google-auth": {
      "@capacitor/core": "$@capacitor/core"
    }
  }
}
