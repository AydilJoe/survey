{
  "name": "duitful",
  "version": "1.25.0",
  "private": true,
  "description": "Duitful \u2014 Capacitor shell for the PWA.",
  "scripts": {
    "postinstall": "node scripts/patch-google-auth.mjs",
    "fetch:tesseract": "node scripts/fetch-tesseract.mjs",
    "build:guides": "node scripts/build-guides.mjs",
    "build:web": "node scripts/build-web.mjs",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor \"#e8dfd0\" --iconBackgroundColorDark \"#2a2420\" --splashBackgroundColor \"#e8dfd0\" --splashBackgroundColorDark \"#2a2420\" && node scripts/generate-stat-icon.mjs",
    "native:notification-listener": "node scripts/install-notification-listener.mjs",
    "patch:android": "node scripts/patch-android-aapt.mjs",
    "patch:android-camera": "node scripts/patch-android-camera.mjs",
    "patch:android-biometric": "node scripts/patch-android-biometric.mjs",
    "patch:android-applinks": "node scripts/patch-android-applinks.mjs",
    "patch:android-shortcuts": "node scripts/patch-android-shortcuts.mjs",
    "patch:android-widget": "node scripts/patch-android-widget.mjs",
    "patch:ios": "node scripts/patch-ios.mjs",
    "cap:sync": "npm run build:web && npx cap sync && npm run patch:android && npm run patch:android-camera && npm run patch:android-biometric && npm run patch:android-applinks && npm run patch:android-shortcuts && npm run patch:android-widget && npm run patch:ios && npm run native:notification-listener",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:add:ios": "npm run build:web && npx cap add ios",
    "cap:add:android": "npm run build:web && npx cap add android",
    "cap:migrate": "npx cap migrate",
    "test:e2e": "node tests/e2e.mjs",
    "check:applinks": "node scripts/check-applinks.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.5",
    "playwright": "^1.62.0",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.5",
    "@capacitor/app": "^7.0.2",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.6.5",
    "@capacitor/ios": "^7.6.5",
    "@capacitor/local-notifications": "^7.0.6",
    "@capawesome/capacitor-app-update": "^7.2.0",
    "@capgo/capacitor-native-biometric": "^7.6.0",
    "@capgo/capacitor-social-login": "^7.20.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@pantrist/capacitor-plugin-ml-kit-text-recognition": "^7.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/kv": "^3.0.0",
    "cordova-plugin-purchase": "^13.16.0"
  },
  "overrides": {
    "@codetrix-studio/capacitor-google-auth": {
      "@capacitor/core": "$@capacitor/core"
    }
  }
}
