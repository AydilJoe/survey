{
  "name": "duitful",
  "version": "1.0.0",
  "private": true,
  "description": "Duitful — Capacitor shell for the PWA.",
  "scripts": {
    "fetch:tesseract": "node scripts/fetch-tesseract.mjs",
    "build:guides": "node scripts/build-guides.mjs",
    "build:web": "node scripts/build-web.mjs",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor \"#e8dfd0\" --iconBackgroundColorDark \"#2a2420\" --splashBackgroundColor \"#e8dfd0\" --splashBackgroundColorDark \"#2a2420\" && node scripts/generate-stat-icon.mjs",
    "cap:sync": "npm run build:web && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:add:ios": "npm run build:web && npx cap add ios",
    "cap:add:android": "npm run build:web && npx cap add android"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/local-notifications": "^6.1.2",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "cordova-plugin-purchase": "^13.12.1"
  }
}
