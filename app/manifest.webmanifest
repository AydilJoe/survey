      "icons": [
        {
          "src": "icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Scan a receipt",
      "short_name": "Scan",
      "description": "Read a receipt into an expense",
      "url": "/app?action=scan",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Split a bill",
      "short_name": "Split",
