      "url": "/app?action=split",
      "icons": [
        {
          "src": "icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Log a debt payment",
      "short_name": "Pay debt",
